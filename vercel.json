{
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "create-react-app"
    },
    "backend": {
      "root": "backend",
      "routePrefix": "/_/backend",
      "framework": "fastapi",
      "entrypoint": "server.py"
    }
  },
  "rewrites": [
    {
      "source": "/landings/:path*",
      "destination": "https://litix-landings.vercel.app/:path*"
    }
  ]
}
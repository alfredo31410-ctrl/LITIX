{
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "routePrefix": "/",
      "framework": "create-react-app"
    },
    "backend": {
      "root": "backend",
      "routePrefix": "/_/backend",
      "framework": "fastapi",
      "entrypoint": "server.py"
    }
  },
  "rewrites": [
    {
      "source": "/universidad-no-enseno",
      "destination": "https://litix-landings.vercel.app/universidad-no-enseno"
    },
    {
      "source": "/universidad-no-enseno/gracias",
      "destination": "https://litix-landings.vercel.app/universidad-no-enseno/gracias"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://litix-landings.vercel.app/assets/:path*"
    },
    {
      "source": "/config.js",
      "destination": "https://litix-landings.vercel.app/config.js"
    },
    {
      "source": "/landings/:path*",
      "destination": "https://litix-landings.vercel.app/:path*"
    }
  ]
}
